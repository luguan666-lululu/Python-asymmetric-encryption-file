     <!-- ========== 消息加密：独立加密页面 ========== -->
     <widget class="QWidget" name="tab_message">
      <attribute name="title"><string>消息加密</string></attribute>
      <property name="font"><font><pointsize>14</pointsize></font></property>
      <layout class="QVBoxLayout" name="verticalLayout_message">
       <item>
        <widget class="QScrollArea" name="scrollArea_message">
         <property name="widgetResizable"><bool>true</bool></property>
         <widget class="QWidget" name="scrollAreaWidgetContents_message">
          <layout class="QVBoxLayout" name="verticalLayout_scroll_message">
           <item>
            <widget class="QLabel" name="label_message_hint">
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
&lt;p&gt;&lt;span style=&quot; font-size:14pt; font-weight:700;&quot;&gt;加密消息&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot; font-size:13pt;&quot;&gt;输入对面名称和消息，点击“加密消息”。密文保存为当前运行目录下的 &lt;b&gt;文件——密文&lt;/b&gt;，可直接发送给对方。&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="wordWrap"><bool>true</bool></property>
            </widget>
           </item>
