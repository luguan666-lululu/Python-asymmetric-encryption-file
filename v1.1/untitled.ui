     <!-- ========== 关于 ========== -->
     <widget class="QWidget" name="tab_about">
      <attribute name="title">
       <string>关于</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_about">
       <item>
        <widget class="QScrollArea" name="scrollArea_about">
         <property name="widgetResizable">
          <bool>true</bool>
         </property>
         <widget class="QWidget" name="scrollAreaWidgetContents_about">
          <layout class="QVBoxLayout" name="verticalLayout_scroll_about">
           <item>
            <widget class="QLabel" name="label_about">
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;版本&lt;/b&gt;：v1.1&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;密钥封装&lt;/b&gt;：ML-KEM-1024 + Classic McEliece-8192128，各两次&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;对称加密&lt;/b&gt;：AES-256-GCM + ChaCha20-Poly1305&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;会话认证&lt;/b&gt;：ML-DSA-87 + SLH-DSA-SHAKE-256f，认证共享秘密摘要&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;私钥保护&lt;/b&gt;：可选 Argon2id（512 MiB、迭代数 4、lanes 4），ChaCha20-Poly1305 + Cobblestone256&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;功能&lt;/b&gt;：文件、文本消息、密文类型识别、顺序异常提示&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;&lt;b&gt;源码环境&lt;/b&gt;：本轮验证于 Windows x64 / Python 3.14.7&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:14pt;&quot;&gt;后量子算法不等于完整协议已获安全认证。本程序无前向保密，顺序检查不严格防重放；未经过独立安全审计，详细安全边界以项目说明为准。&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
