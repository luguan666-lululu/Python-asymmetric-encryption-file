     <!-- ========== 页1：程序说明 ========== -->
     <widget class="QWidget" name="tab_manual">
      <attribute name="title">
       <string>程序说明</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_manual">
       <item>
        <widget class="QScrollArea" name="scrollArea_manual">
         <property name="widgetResizable">
          <bool>true</bool>
         </property>
         <widget class="QWidget" name="scrollAreaWidgetContents_manual">
          <layout class="QVBoxLayout" name="verticalLayout_scroll_manual">
           <item>
            <widget class="QLabel" name="label_manual">
             <property name="text">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;
&lt;p&gt;&lt;span style=&quot;font-size:15pt;font-weight:700;&quot;&gt;后量子加密程序 v1.1 — 使用说明&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;这是离线文件与消息加密工具。内容在本机处理，密文由你自行传输。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;font-weight:700;&quot;&gt;第一步：生成密钥&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;输入通信对方在你这里的名字。例如 Alice 要与 Bob 通信，输入 Bob，生成 Bob——私钥和 Bob——公钥。刚生成时两个文件都属于 Alice。Bob 在自己的电脑输入 Alice，生成自己的密钥。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;生成时可设置私钥密码。若在密码输入框取消，当前程序会提示并保存未加密私钥；忘记已设置的密码没有恢复机制。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;font-weight:700;&quot;&gt;第二步：交换公钥&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;先备份刚生成的自己的公钥，再通过可信渠道把它发给对方。Alice 将收到的 Bob 公钥保存为 Bob——公钥；Bob 将收到的 Alice 公钥保存为 Alice——公钥，替换同名公钥文件。双方始终保留自己的私钥，不发送私钥。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;&lt;b&gt;关键规则：对方名称——私钥属于自己，对方名称——公钥属于对方。&lt;/b&gt; 所有密钥和密文放在当前工作目录。首次交换及以后换钥都应核验来源。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;font-weight:700;&quot;&gt;第三步：加密文件或消息&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;在文件加密页选择文件，或在消息加密页输入文字；输入对面名称后加密。输出固定为文件——密文，完成后再发送。确认覆盖后不保证失败时仍能找回旧密文。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;font-weight:700;&quot;&gt;第四步：解密&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;收到密文后命名为文件——密文，放到当前工作目录；在解密页输入发送方名称。程序自动识别文件或消息：文件恢复名称输出，消息显示在页面中。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;font-weight:700;&quot;&gt;顺序与安全边界&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;文件和消息共用顺序检查，异常时可以选择继续。这是提醒，不严格阻止重放。崩溃、断电、读写失败和恢复旧备份可能导致顺序混乱；私钥、公钥文件会随使用更新。&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&lt;span style=&quot;font-size:13pt;&quot;&gt;本程序无前向保密，不保证隐藏精确长度或防止解锁后的内存读取。未经独立安全审计，详细安全边界以项目说明为准。大文件处理时界面可能暂时无响应。&lt;/span&gt;&lt;/p&gt;
&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="alignment">
              <set>Qt::AlignLeading|Qt::AlignLeft|Qt::AlignTop</set>
             </property>
             <property name="wordWrap">
              <bool>true</bool>
             </property>
            </widget>
           </item>
          </layout>
         </widget>
        </widget>
       </item>
      </layout>
     </widget>

